+/* Number badges advertise the 1/2/3 mode keys without changing button height. */
+.kiri-mode-btn__badge {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-width: 13px;
+  height: 13px;
+  padding: 0 3px;
+  border-radius: 4px;
+  background: rgba(255, 255, 255, 0.12);
+  color: rgba(255, 255, 255, 0.5);
+  font: 600 9.5px ui-monospace, SFMono-Regular, Menlo, monospace;
+  line-height: 1;
+}
+
+.kiri-mode-btn[data-active] .kiri-mode-btn__badge {
+  background: rgba(0, 0, 0, 0.08);
+  color: rgba(0, 0, 0, 0.5);
+}
+
+/* The frozen screen can offer resize or move cursors; overlay chrome keeps a
+   neutral pointer so dragging a panel never looks like moving the region. */
+.kiri-capture-toolbar,
+.kiri-record-options { cursor: default; }
+
 .kiri-mode-btn:focus { outline:none; box-shadow:none; }
 .kiri-mode-btn:focus-visible { box-shadow:inset 0 0 0 1px #777; }
 
