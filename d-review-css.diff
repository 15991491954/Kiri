diff --git a/src/qr/qr.css b/src/qr/qr.css
index 8b2b761..6145066 100644
--- a/src/qr/qr.css
+++ b/src/qr/qr.css
@@ -12,25 +12,14 @@
 .kiri-qr-marker:disabled { opacity: .55; cursor: wait; }
 .kiri-qr-marker svg { display: block; pointer-events: none; }
 .qr-details { min-width: 0; }
-.qr-content { white-space: pre-wrap; overflow-wrap: anywhere; user-select: text; -webkit-user-select: text; line-height: 1.75; font-size: 14px; padding: 18px 0; box-sizing: border-box; max-height: min(240px, 30vh); overflow: auto; unicode-bidi: plaintext; }
+.qr-content { white-space: pre-wrap; overflow-wrap: anywhere; user-select: text; -webkit-user-select: text; cursor: text; line-height: 1.75; font-size: 14px; padding: 18px 0; box-sizing: border-box; max-height: min(240px, 30vh); overflow: auto; unicode-bidi: plaintext; }
 .qr-host, .qr-warning, .qr-feedback { font-size: 13px; line-height: 1.6; overflow-wrap: anywhere; }
 .qr-host, .qr-feedback { color: var(--kiri-secondary-label); }
 .qr-host { max-height: 4.8em; overflow: auto; }
 .qr-warning { color: var(--kiri-coral); }
 .qr-actions { display: flex; gap: 8px; flex-wrap: wrap; }
 .qr-prompt { color: var(--kiri-secondary-label); font-size: 13px; line-height: 1.7; padding: 24px 0; }
-/* Saved QR details use the same metadata/action line as Text History. */
-.qr-details--saved .qr-details__header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; min-height: 36px; padding-bottom: 18px; margin-bottom: 24px; border-bottom: 1px solid var(--kiri-surface-border); }
-.qr-details--saved .qr-actions { justify-content: flex-end; }
-.qr-details--saved .qr-details__body { display: grid; grid-template-columns: 200px minmax(0, 1fr); align-items: start; gap: 28px; }
 .qr-details__content { min-width: 0; }
-.qr-favorite-image { display: block; width: 200px; max-width: 100%; max-height: 240px; box-sizing: border-box; padding: 12px; object-fit: contain; background: var(--kiri-canvas); border: 1px solid var(--kiri-surface-border); border-radius: 8px; }
-.qr-details--saved .qr-content { padding: 0 0 12px; max-height: none; }
-.qr-details--saved .qr-host { margin: 0; }
-@container (max-width: 560px) {
-  .qr-details--saved .qr-details__body { grid-template-columns: 1fr; gap: 20px; }
-  .qr-details--saved .qr-actions { justify-content: flex-start; }
-}
 
 .qr-overlay, .qr-results-inline { position: absolute; inset: 0; pointer-events: none; }
 .qr-overlay { z-index: 20; }
diff --git a/src/styles/design-system.css b/src/styles/design-system.css
index a2853f7..2c92ef9 100644
--- a/src/styles/design-system.css
+++ b/src/styles/design-system.css
@@ -748,6 +748,31 @@ button:active:not(:disabled) {
   box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
 }
 
+/* Number badges advertise the 1/2/3 mode keys without changing button height. */
+.kiri-mode-btn__badge {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-width: 13px;
+  height: 13px;
+  padding: 0 3px;
+  border-radius: 4px;
+  background: rgba(255, 255, 255, 0.12);
+  color: rgba(255, 255, 255, 0.5);
+  font: 600 9.5px ui-monospace, SFMono-Regular, Menlo, monospace;
+  line-height: 1;
+}
+
+.kiri-mode-btn[data-active] .kiri-mode-btn__badge {
+  background: rgba(0, 0, 0, 0.08);
+  color: rgba(0, 0, 0, 0.5);
+}
+
+/* The frozen screen can offer resize or move cursors; overlay chrome keeps a
+   neutral pointer so dragging a panel never looks like moving the region. */
+.kiri-capture-toolbar,
+.kiri-record-options { cursor: default; }
+
 .kiri-mode-btn:focus { outline:none; box-shadow:none; }
 .kiri-mode-btn:focus-visible { box-shadow:inset 0 0 0 1px #777; }
 
diff --git a/src/windows/pin-window.css b/src/windows/pin-window.css
index 20c0c32..a130933 100644
--- a/src/windows/pin-window.css
+++ b/src/windows/pin-window.css
@@ -10,6 +10,15 @@
 .kiri-pin-action:disabled { opacity: .5; cursor: default; }
 .pin-window__image p, .pin-window__error { margin: 0; padding: 8px 12px; background: var(--kiri-card); color: var(--kiri-secondary-label); font-size: 12px; text-align: center; }
 .pin-window__error { position: absolute; bottom: 12px; left: 12px; right: 12px; z-index: 3; border-radius: 6px; }
+.pin-window__zoom { position: absolute; z-index: 3; padding: 3px 8px; border-radius: 6px;
+  background: rgba(17, 17, 17, .82); color: #fff; font-size: 12px; font-variant-numeric: tabular-nums;
+  pointer-events: none; }
+/* The badge follows the corner nearest the pointer, because an anchored zoom
+   can push the opposite corner of the window off the screen. */
+.pin-window__zoom[data-corner="top-left"] { top: 8px; left: 8px; }
+.pin-window__zoom[data-corner="top-right"] { top: 40px; right: 8px; }
+.pin-window__zoom[data-corner="bottom-left"] { bottom: 8px; left: 8px; }
+.pin-window__zoom[data-corner="bottom-right"] { bottom: 8px; right: 8px; }
 .pin-window__resize { position: absolute; bottom: 0; right: 0; width: 16px; height: 16px; z-index: 2; cursor: nwse-resize; }
 .pin-window__resize::after { content: ""; position: absolute; bottom: 3px; right: 3px; width: 6px; height: 6px; border-right: 2px solid #fff; border-bottom: 2px solid #fff; filter: drop-shadow(0 0 1px #000); opacity: 0; }
 .pin-window:hover .pin-window__resize::after { opacity: 1; }
