+/// Stable one-based monitor indices for the current desktop layout. These are
+/// the same ids stored in `CapturedDisplay::display_id` and can be passed back
+/// to `capture_display_by_id` while the layout is unchanged.
+///
+/// `xcap::Monitor::id()` is the raw `HMONITOR` handle, which never equals the
+/// one-based position `CapturedDisplay::display_id` stores. Returning handles
+/// here made the coordinator treat the pointer display as a second display and
+/// stack a duplicate overlay on it, so this function must keep the session id
+/// space: position + 1.
+pub fn display_ids() -> Result<Vec<u32>> {
+    xcap::Monitor::all()?
+        .iter()
+        .enumerate()
+        .map(|(position, _)| windows_capture_monitor_index(position))
+        .collect()
+}
+
+/// Freeze one already-known monitor after the primary overlay is interactive.
+/// A disconnected or reordered monitor fails closed instead of selecting a
+/// different display's pixels.
+pub fn capture_display_by_id(id: u32) -> Result<CapturedDisplay> {
+    run_frozen_capture_worker("kiri-frozen-display", move |progress| {
+        let monitors = xcap::Monitor::all()?;
+        let position = display_id_position(id)?;
+        let monitor = monitors
+            .get(position)
+            .ok_or_else(|| anyhow!("The display is no longer available."))?;
+        capture_monitor(monitor, Some(progress))
+    })
+}
+
+/// Inverse of `windows_capture_monitor_index`: a session display id is a
+/// one-based enumeration position, not a native `HMONITOR` handle.
+fn display_id_position(id: u32) -> Result<usize> {
+    let zero_based = id
+        .checked_sub(1)
+        .ok_or_else(|| anyhow!("The display id is invalid."))?;
+    usize::try_from(zero_based).map_err(|_| anyhow!("The display id is too large."))
+}
